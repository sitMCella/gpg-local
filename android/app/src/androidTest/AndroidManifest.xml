<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- Serves share-test documents as real content:// URIs from another package, like a file manager
             would. Exported because the instrumentation runs under the app's UID, which could not issue a
             grant for a non-exported provider of the test package. Test APK only. -->
        <provider
            android:name="com.gpglocal.app.share.TestDocumentProvider"
            android:authorities="com.gpglocal.app.test.documents"
            android:exported="true"
            android:grantUriPermissions="true" />
    </application>
</manifest>

<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: the keyring (filesDir) never leaves the device through cloud backup or device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="." />
    </device-transfer>
</data-extraction-rules>
